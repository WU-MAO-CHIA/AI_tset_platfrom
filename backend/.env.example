DATABASE_URL=sqlite+aiosqlite:///./data/autotest.db
MEDIA_ROOT=./data/media
ROBOT_SCRIPTS_DIR=./robot_scripts
PARALLEL_MAX_WORKERS=5
# 同時執行幾筆清單／試跑（其餘排隊）；單一清單內的平行度由 PARALLEL_MAX_WORKERS 限制
EXECUTION_MAX_CONCURRENT=1
# 排程時間的時區（IANA 名稱）；SCHEDULE_ENABLED=false 可關閉排程器
SCHEDULE_TIMEZONE=Asia/Taipei
SCHEDULE_ENABLED=true

# LLM API Keys (set at least one)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Default LLM model（後台「目前啟用模型」未設定時的 fallback）
DEFAULT_LLM_MODEL=claude-sonnet-5

# 本地 Ollama 原生 API base URL（留空＝不啟用本地模型）
OLLAMA_BASE_URL=http://localhost:11434

# JWT Authentication
# 注意：JWT_SECRET_KEY 必須是固定值，否則每次重啟都會讓既有 token 失效（造成 401）
# 長度至少 32 字元；APP_ENV=prod 時若仍為預設值，後端將拒絕啟動。
JWT_SECRET_KEY=change-me-to-a-strong-random-secret-key
# 閒置逾時（分鐘）：有操作就自動續期，閒置超過此時間需重新登入
JWT_EXPIRE_MINUTES=10

# dev | prod | test；prod 啟用嚴格啟動檢查（拒絕預設 secret/密碼）與 Secure cookie
APP_ENV=dev

# Initial admin account (used by seed_admin.py)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
